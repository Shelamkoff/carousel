{
  "name": "@shelamkoff/carousel",
  "version": "1.0.0",
  "description": "Position-first framework-agnostic carousel with composable plugins",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./styles.css": "./dist/styles/carousel.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README.ru.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node ../scripts/dev-server.mjs /carousel/demo.html",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "dependencies": { "@shelamkoff/event-bus": "^1.0.0" },
  "keywords": ["carousel", "slider", "plugins", "framework-agnostic", "esm"],
  "author": "Shelamkoff",
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/carousel.git"
  },
  "homepage": "https://github.com/Shelamkoff/carousel#readme",
  "bugs": { "url": "https://github.com/Shelamkoff/carousel/issues" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
