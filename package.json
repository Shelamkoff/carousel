{
  "name": "@shelamkoff/carousel",
  "version": "1.0.0",
  "description": "Framework-agnostic JavaScript carousel and slider with responsive layouts, loop mode, touch gestures, animations, accessibility, and composable plugins",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./styles.css": "./dist/styles/carousel.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node scripts/dev-server.mjs /demo.html",
    "test": "node --test",
    "typecheck": "tsc -p type-tests/tsconfig.json",
    "check": "npm run test && npm run typecheck && npm run build",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@shelamkoff/event-bus": "^1.0.0"
  },
  "keywords": [
    "javascript",
    "carousel",
    "slider",
    "image-carousel",
    "responsive",
    "touch",
    "swipe",
    "autoplay",
    "thumbnails",
    "parallax",
    "accessibility",
    "plugins",
    "vanilla-js",
    "framework-agnostic",
    "esm"
  ],
  "author": "Shelamkoff",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/carousel.git"
  },
  "homepage": "https://shelamkoff.github.io/carousel/",
  "bugs": {
    "url": "https://github.com/Shelamkoff/carousel/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
